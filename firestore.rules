rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // El ID de sala es un secreto aleatorio de 32 caracteres compartido por enlace.
    // Cualquier persona con el enlace puede ver y cambiar su checklist.
    match /rooms/{roomId}/items/{itemId} {
      allow get, list: if request.auth != null
        && roomId.matches('[A-Za-z0-9_-]{32}')
        && itemId.matches('[a-z0-9_-]{1,45}');
      allow create, update: if request.auth != null
        && roomId.matches('[A-Za-z0-9_-]{32}')
        && itemId.matches('[a-z0-9_-]{1,45}')
        && request.resource.data.keys().hasOnly(['checked','updatedAt'])
        && request.resource.data.checked is bool
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.size() == 2;
      allow delete: if false;
    }
  }
}
